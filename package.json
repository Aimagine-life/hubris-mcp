{
  "name": "hubris-mcp",
  "version": "0.2.0",
  "mcpName": "pw.hubris/hubris-mcp",
  "description": "MCP server for Hubris — an OpenAI-compatible LLM gateway billed in rubles. Catalogue, balance, spending and every kind of model — text, embeddings, rerank, images, speech, transcription, video — over stdio.",
